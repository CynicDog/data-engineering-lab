# Tunables consumed by the scripts/ (sourced by up.sh / down.sh).
# Copy to .env and adjust if the defaults collide with something local.

# Kind cluster name.
CLUSTER_NAME=lakehouse

# Kubernetes namespace for the whole stack.
NAMESPACE=lakehouse

# Local image tags (loaded into Kind; never pushed to a registry).
AIRFLOW_IMAGE=lakehouse/airflow:dev
SPARK_IMAGE=lakehouse/spark:dev

# Host ports (mapped from NodePort via kind-config.yaml extraPortMappings).
AIRFLOW_UI_HOST_PORT=8110
MINIO_CONSOLE_HOST_PORT=9031

# MinIO root credentials (also the S3A creds used by Spark + the seed Job).
LAKE_S3_ACCESS_KEY=minioadmin
LAKE_S3_SECRET_KEY=minioadmin

# Path to the sibling source project (the lakehouse package is synced from here).
SOURCE_PROJECT=../databricks_lakehouse
