# Copy to .env and adjust as needed
# AIRFLOW_UID must match your host user id (run: id -u)
AIRFLOW_UID=50000

# Airflow image — bump patch version as needed
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.2-python3.12

# Admin user created by airflow-init
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Project deps installed into the Airflow image at build time
# (see Dockerfile — these are mirrored from pyproject.toml)

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAMBDA_BUCKET=lambda-lake

# Kafka topic seeded by scripts/seed_kafka.py
LAMBDA_TOPIC=events

# Warehouse DB (separate from the airflow metadata DB, same Postgres instance)
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
