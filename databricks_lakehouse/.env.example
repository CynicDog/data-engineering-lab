AIRFLOW_UID=50000

# MinIO — ADLS Gen2 equivalent
LAKE_BUCKET=lakehouse
LAKE_S3_ENDPOINT=http://minio:9000
LAKE_S3_ACCESS_KEY=minioadmin
LAKE_S3_SECRET_KEY=minioadmin

# ODS source database (PostgreSQL mimicking on-premise ODS)
ODS_URL=postgresql+psycopg2://ods:ods@postgres:5432/ods

# Active configuration profile: dev | prod
LAKEHOUSE_PROFILE=dev
